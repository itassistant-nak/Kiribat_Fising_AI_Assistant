# Production environment template — Kiribati AI Fisheries Assistant API
# Copy to backend/.env on the server and fill every CHANGE_ME value.
# NEVER commit the real .env (it is gitignored). NEVER print it in logs/CI.

APP_NAME="Kiribati Fisheries API"
APP_ENV=production
APP_KEY=CHANGE_ME__run_php_artisan_key_generate
APP_DEBUG=false
APP_TIMEZONE=Pacific/Tarawa
APP_URL=https://CHANGE_ME.example.gov.ki

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database: MySQL is the production target (SQLite only for local demo) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kiribati_fisheries
DB_USERNAME=kiribati_app
DB_PASSWORD=CHANGE_ME__32plus_random_chars
DB_CHARSET=utf8mb4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Meta Model API (backend only; never expose to clients or git) ---
# Leave empty to run on the offline morphological knowledge base.
META_AI_ENDPOINT=https://api.meta.ai/v1/responses
META_AI_MODEL=muse-wonder-1.0
MODEL_API_KEY=
META_AI_TIMEOUT=15

# --- CORS: browser clients (Flutter web / split-host dashboard) ---
# Add each production origin to backend/config/cors.php as well.
FRONTEND_URL=https://CHANGE_ME.example.gov.ki
